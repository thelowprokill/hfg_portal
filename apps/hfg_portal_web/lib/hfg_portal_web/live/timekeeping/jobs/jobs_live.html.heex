<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-6"><.bnw_button_new /></div>

  <.form :let={f}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table height="80vh">
      <:header>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:name}>Name</.bnw_table_header_filter></th>
        <th class="p-2">Client</th>
        <th class="p-2">Rate</th>
        <th class="p-2"></th>
        <th class="p-2"></th>
      </:header>
      <%= for job <- @jobs do %>
        <tr phx-click="log_time" phx-value-id={job.id} class={[
          "cursor-pointer",
          MapSet.member?(@open_job_ids, job.id) && "bg-green-100 dark:bg-green-900/40"
        ]}>
          <td class="px-2">
            <%= job.name %>
            <%= if MapSet.member?(@open_job_ids, job.id) do %>
              <span class="ml-2 text-xs font-medium text-green-700 dark:text-green-400 uppercase tracking-wide">Running</span>
            <% end %>
          </td>
          <td class="px-2"><%= job.client || "—" %></td>
          <td class="px-2"><%= if job.hourly_rate, do: "$#{job.hourly_rate}/hr", else: "—" %></td>
          <td class="px-2"><.bnw_button_edit phx-value-id={job.id} /></td>
          <td class="px-2"><.bnw_button_delete phx-value-id={job.id} /></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
