<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-6"><.bnw_button_new /></div>

  <.form :let={f}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table height="80vh">
      <:header>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:name}>Name</.bnw_table_header_filter></th>
        <th class="p-2">Client</th>
        <th class="p-2">Rate</th>
        <th class="p-2">Total Time</th>
        <th class="p-2"></th>
        <th class="p-2"></th>
      </:header>
      <%= for job <- @jobs do %>
        <tr phx-click="log_time" phx-value-id={job.id} class={[
          "cursor-pointer",
          Map.has_key?(@open_job_starts, job.id) && "bg-green-100 dark:bg-green-900/40"
        ]}>
          <td class="px-2">
            <%= job.name %>
            <%= if start_time = Map.get(@open_job_starts, job.id) do %>
              <span class="ml-2 inline-flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 scale-125 text-green-700 dark:text-green-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
                  <line x1="12" y1="12" x2="12" y2="7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  <line
                    x1="12" y1="12" x2="15.5" y2="12"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    class="origin-center animate-spin"
                    style="animation-duration: 2s"
                  />
                </svg>
                <span class="text-xs font-medium text-green-700 dark:text-green-400 uppercase tracking-wide">Running</span>
                <span
                  class="font-mono text-xs tabular-nums text-green-700 dark:text-green-400"
                  phx-hook="ElapsedTimer"
                  id={"jobs_elapsed_#{job.id}"}
                  data-start={DateTime.to_iso8601(start_time)}
                >00:00:00</span>
              </span>
            <% end %>
          </td>
          <td class="px-2"><%= job.client || "—" %></td>
          <td class="px-2"><%= if job.hourly_rate, do: "$#{job.hourly_rate}/hr", else: "—" %></td>
          <td class="px-2 font-mono text-sm tabular-nums">
            <%= if start_time = Map.get(@open_job_starts, job.id) do %>
              <span
                phx-hook="ElapsedTimer"
                id={"jobs_total_#{job.id}"}
                data-start={DateTime.to_iso8601(start_time)}
                data-base-seconds={Map.get(@job_total_seconds, job.id, 0)}
              ><%= format_seconds(Map.get(@job_total_seconds, job.id, 0)) %></span>
            <% else %>
              <%= format_seconds(Map.get(@job_total_seconds, job.id, 0)) %>
            <% end %>
          </td>
          <td class="px-2"><.bnw_button_edit phx-value-id={job.id} /></td>
          <td class="px-2"><.bnw_button_delete phx-value-id={job.id} /></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
