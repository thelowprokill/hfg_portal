<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-6"><.bnw_button_new /></div>

  <.form :let={f}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table height="80vh">
      <:header>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:description}>Description</.bnw_table_header_filter></th>
        <th class="p-2">Bucket</th>
        <th class="p-2">Amount</th>
        <th class="p-2">Frequency</th>
        <th class="p-2">Next Due</th>
        <th class="p-2">Active</th>
        <th class="p-2"></th>
        <th class="p-2"></th>
      </:header>
      <%= for expense <- @scheduled_expenses do %>
        <tr>
          <td class="px-2"><%= expense.description %></td>
          <td class="px-2"><%= if expense.bucket, do: expense.bucket.name, else: "—" %></td>
          <td class="px-2">$<%= expense.amount %></td>
          <td class="px-2"><%= expense.frequency %></td>
          <td class="px-2"><%= expense.next_due_date %></td>
          <td class="px-2">
            <.bnw_button_default phx_click="toggle_active" phx-value-id={expense.id}>
              <%= if expense.active, do: "Active", else: "Inactive" %>
            </.bnw_button_default>
          </td>
          <td class="px-2"><.bnw_button_edit phx-value-id={expense.id} /></td>
          <td class="px-2"><.bnw_button_delete phx-value-id={expense.id} /></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
