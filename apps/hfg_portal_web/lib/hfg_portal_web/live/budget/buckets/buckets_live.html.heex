<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-6"><.bnw_button_new /></div>

  <.form :let={f}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table height="80vh">
      <:header>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:name}>Name</.bnw_table_header_filter></th>
        <th class="p-2">Type</th>
        <th class="p-2">Monthly Expenses</th>
        <th class="p-2">Monthly Budget</th>
        <th class="p-2">Monthly Contribution</th>
        <th class="p-2">Max Balance</th>
        <th class="p-2"></th>
        <th class="p-2"></th>
      </:header>
      <%= for bucket <- @buckets do %>
        <tr>
          <td class="px-2"><%= bucket.name %></td>
          <td class="px-2 capitalize"><%= String.replace(bucket.type, "_", " ") %></td>
          <td class="px-2">$<%= Map.get(@monthly_expenses, bucket.id, Decimal.new(0)) %></td>
          <td class="px-2"><%= if bucket.monthly_budget, do: "$#{bucket.monthly_budget}", else: "—" %></td>
          <td class="px-2"><%= if bucket.monthly_contribution, do: "$#{bucket.monthly_contribution}", else: "—" %></td>
          <td class="px-2"><%= if bucket.max_balance, do: "$#{bucket.max_balance}", else: "—" %></td>
          <td class="px-2"><.bnw_button_edit phx-value-id={bucket.id} /></td>
          <td class="px-2"><.bnw_button_delete phx-value-id={bucket.id} /></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
