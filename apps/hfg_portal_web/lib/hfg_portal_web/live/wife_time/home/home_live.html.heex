<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-6"><.bnw_button_new /></div>

  <.form :let={f}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table height="80vh">
      <:header>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:entry_date}>Date</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:happened}>Happened</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:comment}>Comment</.bnw_table_header_filter></th>
        <th class="p-2"></th>
        <th class="p-2"></th>
      </:header>
      <%= for wife_time <- @wife_times do %>
        <tr>
          <td class="px-2"><%= wife_time.entry_date %></td>
          <td class="px-2"><.bnw_icon bnw_icon={if wife_time.happened, do: "check", else: "ban"}/></td>
          <td class="px-2"><%= wife_time.comment %></td>
          <td class="px-2"><.bnw_button_edit   phx-value-id={wife_time.id} /></td>
          <td class="px-2"><.bnw_button_delete phx-value-id={wife_time.id} /></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
