<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-6"><.bnw_button_new /></div>
  <div class="py-3"><.bnw_button_primary phx_click="reset_filters">Reset Filters</.bnw_button_primary></div>
  
  <.form :let={s}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table id="infinite_scroll_table" load_more={!Enum.any?(@search_stack, &(&1.show))}>
      <:header>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:name}>        Name        </.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:address}>     Address     </.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:description}> Description </.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:priority_id}> Priority    </.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:avg_runtime}> Avg Runtime </.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:asynchronous}>Asynchronous</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:active}>      Active      </.bnw_table_header_filter></th>
        <th class="p-2"></th>
        <th class="p-2"></th>
      </:header>
      <%= for item <- @jobs do %>
        <tr>
          <td><%= item.name %></td>
          <td><%= item.address %></td>
          <td><%= item.description %></td>
          <td><%= item.priority.name %></td>
          <td><%= item.avg_runtime %></td>
          <td><.bnw_button_toggle_active active={item.asynchronous} phx-value-key={:asynchronous} phx-value-id={item.id} /></td>
          <td><.bnw_button_toggle_active active={item.active}       phx-value-key={:active}       phx-value-id={item.id} /></td>
          <td><.bnw_button_edit   phx-value-id={item.id} /></td>
          <td><.bnw_button_delete phx-value-id={item.id} /></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
