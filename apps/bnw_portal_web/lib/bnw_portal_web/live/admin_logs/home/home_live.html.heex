<div>
  <div class="flex h-[5vh]">
    <div class="w-1/2"><h3 class="text-xl"><%= @page_title %></h3></div>
    <div class="w-full"/>
    <div class="w-1/2 inline-flex">
      <div class="p-2 mx-4"><.bnw_button_icon phx_click="refresh" bnw_icon="arrow-path" class={if @anim.loading, do: "animate-spin"}/></div>
      <.bnw_button_primary_pill phx_click="hidden_sections" class="w-full">
        Hidden Sections
      </.bnw_button_primary_pill>
    </div>
  </div>

  <div class="overflow-auto" style="height: calc(90vh - 15px)">
    <%= if !Enum.any?(@hidden_sections, &(&1.section == "med_coolers")) && (@med_cooler.result || @med_cooler_saved.result)  do %>
      <div class="w-full shadow-lg text-xl px-4 py-4 pt-6 ">Med Coolers</div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        <%= for sensor <- (if @med_cooler.result, do: @med_cooler.result, else: @med_cooler_saved.result) do %>
          <div class="pt-4 rounded overflow-hidden shadow-lg">
            <div class="px-6 mt-4 text-l">
              <a href={"https://bnw-dashboard.beefnw.com/sensors/generic_sensor?page=med_cooler&sensor=#{sensor.id}&yard=#{sensor.yard_id}"} target="_blank"><%= sensor.name %></a>
            </div>
            <div class="px-6 py-1">
              Status
              <.bnw_chart_bar_tick values={sensor.status} keys={%{true => "bg-green-500"}} />
            </div>
            <div class="px-6 py-1">
              Alarms
              <.bnw_chart_bar_tick values={sensor.alarm} keys={%{0 => "bg-green-500"}} />
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= if !Enum.any?(@hidden_sections, &(&1.section == "weather_stations")) && (@weather_station.result || @weather_station_saved.result) do %>
      <div class="w-full shadow-lg text-xl px-4 py-4 pt-6">Weather Stations</div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        <%= for sensor <- (if @weather_station.result, do: @weather_station.result, else: @weather_station_saved.result) do %>
          <div class="pt-4 rounded overflow-hidden shadow-lg">
            <div class="px-6 mt-4 text-l">
              <a href={"https://bnw-dashboard.beefnw.com/sensors/generic_sensor?page=weather_station&sensor=#{sensor.id}&yard=#{sensor.yard_id}"} target="_blank"><%= sensor.name %></a>
            </div>
            <div class="px-6 py-1">
              Status
              <.bnw_chart_bar_tick values={sensor.status} keys={%{true => "bg-green-500"}} />
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= if !Enum.any?(@hidden_sections, &(&1.section == "turnkey_updates")) && (@turnkey_update.result || @turnkey_update_saved.result) do %>
      <div class="w-full shadow-lg text-xl px-4 py-4 pt-6">TK Updates</div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        <%= for table <- (if @turnkey_update.result, do: @turnkey_update.result, else: @turnkey_update_saved.result) do %>
          <div class="pt-4 rounded overflow-hidden shadow-lg">
            <div class="px-6 mt-4 text-l"><%= table.table %></div>
            <div class="px-6 py-1">
              <%= Enum.count(table.status, &(&1 == 0)) %> / <%= Enum.count(table.status, &(&1 >= 0)) %>
            </div>
            <div class="px-6 py-1">
              Status
              <.bnw_chart_bar_tick values={table.status} keys={%{-1 => "bg-gray-500", 0 => "bg-green-500"}} />
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= if !Enum.any?(@hidden_sections, &(&1.section == "python_scripts")) && (@python_script.result || @python_script_saved.result) do %>
      <div class="w-full shadow-lg text-xl px-4 py-4 pt-6">Python Scripts</div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        <%= for script <- (if @python_script.result, do: @python_script.result, else: @python_script_saved.result) do %>
          <div class="pt-4 rounded overflow-hidden shadow-lg">
            <div class="px-6 mt-4 text-l"><%= script.name %> <%= if script.sub_script, do: "- " <> script.sub_script %></div>
            <div class="px-6 py-1">
              <%= Enum.count(script.status, &(&1 == 0)) %> / <%= Enum.count(script.status, &(&1 >= 0)) %>
            </div>
            <div class="px-6 py-1">
              Status
              <.bnw_chart_bar_tick values={script.status} keys={%{-1 => "bg-gray-500", 0 => "bg-green-500"}} />
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
