<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-2">
    <div class="py-1">
      <%= for company <- @companies |> filter_list(:companies, @home_permissions, @current_user, @admin) do %>
        <.bnw_button_tab selected={company.id == @selected.company} phx_click="select_company" phx-value-id={company.id}><%= company.name %></.bnw_button_tab>
      <% end %>
      <hr/>
    </div>
    <% selected_company = Enum.find(@companies, %{company_budgets: [], draft_types: []}, &(&1.id == @selected.company)) %>
    <div class="py-1">
      <%= for budget <- selected_company.company_budgets |> filter_list(:company_budgets, @home_permissions, @current_user, @admin) do %>
        <.bnw_button_tab selected={budget.id == @selected.budget} phx_click="select_budget" phx-value-id={budget.id}><%= budget.name %></.bnw_button_tab>
      <% end %>
      <hr/>
    </div>
    <div class="py-1">
      <%= for draft_type <- selected_company.draft_types |> filter_list(:draft_types, @home_permissions, @current_user, @admin) do %>
        <.bnw_button_tab selected={draft_type.id == @selected.draft_type} phx_click="select_draft_type" phx-value-id={draft_type.id}><%= draft_type.name %></.bnw_button_tab>
      <% end %>
      <hr/>
    </div>
  </div>

  <%= if @selected.company != 0 && @selected.budget != 0 && @selected.draft_type != 0 do %>
    <%= if check_perm(["edit"], @home_permissions, @selected, "drafts", @current_user, @admin) do %>
      <div class="py-3"><.bnw_button_new>New Draft</.bnw_button_new></div>
    <% end %>

    <div class="w-full flex">
      <%= if check_perm(["view", "lock", "edit"], @home_permissions, @selected, "drafts", @current_user, @admin) do %>
        <div class="w-1/6">
          <%= for draft <- @drafts do %>
            <div>
              <%= if check_perm(["lock", "edit"], @home_permissions, @selected, "drafts", @current_user, @admin) do %>
                <.bnw_button_icon   bnw_icon={if draft.locked, do: "lock", else: "unlock"} phx_click="lock" phx-value-id={draft.id} />
              <% end %>
              <%= if check_perm(["edit"], @home_permissions, @selected, "drafts", @current_user, @admin) do %>
                <.bnw_button_edit   phx-value-id={draft.id} hidden={draft.locked}/>
                <.bnw_button_delete phx-value-id={draft.id} hidden={draft.locked}/>
              <% end %>

              <%= if draft.id == @selected.draft do %>
                <.bnw_button phx_click="select_draft" phx-value-id={draft.id}><span class={"text-primary-main #{if @anim.loading, do: "text-success-main"}"}><%= draft.name %></span></.bnw_button>
              <% else %>
                <.bnw_button phx_click="select_draft" phx-value-id={draft.id}><%= draft.name %></.bnw_button>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="w-5/6">
          <%= if @draft do %>
            <.form :let={f}
              for={@changeset}
              phx-change="save"
              phx-submit="save">
              <DraftItem.draft_item 
                f={f} 
                draft={@draft} 
                draft_type={Enum.find(selected_company.draft_types, %{}, &(&1.id == @draft.draft_type_id))}
                selected={@selected} 
                animal_sexes={@animal_sexes} 
                animal_types={@animal_types} 
                variable_inputs={@variable_inputs} 
                reports={@reports} 
                anim={@anim}
                home_permissions={@home_permissions}
                current_user={@current_user}
                admin={@admin}
              />
            </.form>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
