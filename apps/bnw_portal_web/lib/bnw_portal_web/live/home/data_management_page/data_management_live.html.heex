<div class="flex w-full">

  <div class="block w-full flex">
    <div class="inline-block overflow-scroll pr-5 w-1/2" style="height: 80vh;">
      <%= if @current_user.dev_admin && @current_user.admin_mode do %>
        <!-- this checkbox misaligns the calendar, but only for IT Admins -->
        <div class="">
          <label class="m-2">
            <%= checkbox(
              :edit_mode,
              :edit_mode,
              [
                class: "uk-checkbox",
                id: "all_tables_edit_mode",
                phx_click: "toggle_edit_mode",
                value: @edit_mode
              ]
            ) %>
            Edit Mode
          </label>
        </div>
      <% end %>

      <%= if @edit_mode do %>
        <div><.bnw_button_new class="my-3 w-2/3" btn-text="New Group" phx_click="new_group" /></div>
      <% end %>

      <div class="py-3">
        <%= for {group, i} <- @groups |> Enum.with_index() do %>
          <div class="flex py-3">
            <h3 class="text-xl">
              <%= group.name %>
            </h3>
            <%= if @edit_mode do %>
              <div class="flex justify-end w-full mr-5">
                <%= if i != 0 do %>
                  <.bnw_button_up
                    class="ml-2"
                    phx_click="move_up_group"
                    phx-value-id={group.id}
                  />
                <% end %>
                <.bnw_button_edit 
                    class="ml-2"
                    phx_click="edit_group" 
                    phx-value-id={group.id}
                    uk-tooltip="title: Edit Group" 
                />
                <.bnw_button_delete 
                    class="ml-2"
                    phx_click="delete_group" 
                    phx-value-id={group.id}
                    uk-tooltip="title: Delete Group" 
                />
                <.bnw_button_icon
                    class="ml-2"
                    bnw_icon="plus-circle"
                    phx_click="new_item" 
                    phx-value-id={group.id}
                    uk-tooltip="title: New Item" 
                />
              </div>
            <% end %>
          </div>

          <hr>

          <%= for {item, i} <- group.items |> Enum.with_index() do %>
            <div class="flex my-2 ml-8">
              <!--
              <a class="w-1/3" target={if item.new_tab, do: "_blank", else: "_parent"} href={item.link}>
                <span class="text-primary-main hover:text-primary-hover"><%= item.name %></span>
              </a>
              -->
              <.show_qr_code item={item} show={item.id in @show_qr_codes} />
              <%= if @edit_mode do %>
                <div class="flex justify-end w-1/4 mr-5">
                  <%= if i != 0 do %>
                    <.bnw_button_up
                      class="ml-2"
                      phx_click="move_up_item"
                      phx-value-id={item.id}
                    />
                  <% end %>
                  <.bnw_button_edit 
                    class="ml-2"
                    phx_click="edit_item" 
                    phx-value-id={item.id}
                    uk-tooltip="title: Edit Item" 
                  />
                  <.bnw_button_delete 
                    class="ml-2"
                    phx_click="delete_item" 
                    phx-value-id={item.id}
                    uk-tooltip="title: Delete Item" 
                  />
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
    <%= if (System.get_env("LOCATION") || "bnw") in ["bnw"] do %>
      <div class="inline-block w-1/2">
        <iframe 
          src="https://calendar.google.com/calendar/embed?height=600&wkst=1&bgcolor=%23ffffff&ctz=America%2FLos_Angeles&showTitle=0&mode=AGENDA&src=YmVlZm53LmNvbV9wc3RpNmhpOG1uZzFyZjY5Y20wY3VjZTNyb0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23616161" 
          style="border:solid 1px #777; height: 80vh;" 
          width="800" 
          frameborder="0" 
          scrolling="no">
        </iframe>

      </div>
    <% end %>
    <!--
    <div class="uk-width-1-3" style="float: left; display: inline-block;">
      <script>    
        window.fwSettings={   
          'widget_id':150000004281    
        };    
        !function(){if("function"!=typeof window.FreshworksWidget){var n=function(){n.q.push(arguments)};n.q=[],window.FreshworksWidget=n}}() 
      </script>
      <script type='text/javascript' src='https://widget.freshworks.com/widgets/150000004281.js' async defer></script>
    </div>
    -->
  </div>

  <% modal = stack_tail(@modal_stack) %>
  <%= cond do 
    modal && Map.get(modal, :live, false) -> 
      live_render(
        @socket,
        modal.module, 
        id: "modal_#{modal.modal}_#{modal.id}",
        session: %{"modal" => modal, "parent" => self()}
      )
    modal -> 
      live_component(%{
        module: modal.module, 
        id: "modal_#{modal.modal}_#{modal.id}",
        modal: modal
      })
    true -> nil
  end %>
</div>
