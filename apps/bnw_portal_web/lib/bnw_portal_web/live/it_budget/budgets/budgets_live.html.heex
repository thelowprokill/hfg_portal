<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-6"><.bnw_button_new /></div>

  <div class="py-3"><.bnw_button_primary phx_click="reset_filters">Reset Filters</.bnw_button_primary></div>
  <.form :let={s}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table>
      <:header>
          <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:year}>       Year       </.bnw_table_header_filter></th>
          <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:description}>Description</.bnw_table_header_filter></th>
        <th class="p-2"></th>
        <th class="p-2"></th>
        <th class="p-2"></th>
      </:header>
      <%= for budget <- @budgets do %>
        <tr>
          <td class="px-2"><%= budget.year %></td>
          <td class="px-2"><%= budget.description %></td>
          <td class="px-2"><.bnw_button_primary phx_click="edit_accounts" phx-value-id={budget.id}>Edit Accounts</.bnw_button_primary></td>
          <td class="px-2"><.bnw_button_edit                              phx-value-id={budget.id}>Edit         </.bnw_button_edit></td>
          <td class="px-2"><.bnw_button_delete                            phx-value-id={budget.id}>Delete       </.bnw_button_delete></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
