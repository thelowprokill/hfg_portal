<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-6"><.bnw_button_new /></div>

  <div class="py-3"><.bnw_button_primary phx_click="reset_filters">Reset Filters</.bnw_button_primary></div>
  <.form :let={s}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table>
      <:header>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:name}>       Name       </.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:code}>       Code       </.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={s} search_stack={@search_stack} sort_stack={@sort_stack} field={:description}>Description</.bnw_table_header_filter></th>
        <th class="p-2"></th>
        <th class="p-2"></th>
        <th class="p-2"></th>
      </:header>
      <%= for account <- @accounts do %>
        <tr>
          <td class="px-2"><%= account.name %></td>
          <td class="px-2"><%= account.code %></td>
          <td class="px-2"><%= account.description %></td>
          <td class="px-2"><.bnw_button_primary phx-value-id={account.id} phx_click="edit_subs">Edit Subs</.bnw_button_primary></td>
          <td class="px-2"><.bnw_button_edit    phx-value-id={account.id}>Edit   </.bnw_button_edit></td>
          <td class="px-2"><.bnw_button_delete  phx-value-id={account.id}>Delete </.bnw_button_delete></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
