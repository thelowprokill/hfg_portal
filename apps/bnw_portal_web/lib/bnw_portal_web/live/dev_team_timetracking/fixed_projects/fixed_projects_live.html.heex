<div>
  <h3 class="text-xl"><%= @page_title %></h3>

  <div class="py-6"><.bnw_button_new /></div>

  <.form :let={f}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table height="80vh">
      <:header>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:key}>Key</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:name}>Project</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:description}>Description</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:status}>Status</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:project_percent}>Project %</.bnw_table_header_filter></th>
        <th class="p-2"></th>
        <th class="p-2"></th>
      </:header>
      <%= for project <- @fixed_projects do %>
        <tr phx-click="fixed_timesheets" phx-value-id={project.id} class="cursor-pointer">
          <td class="px-2"><%= project.key %></td>
          <td class="px-2"><%= project.name %></td>
          <td class="px-2"><%= project.description %></td>
          <td class="px-2"><%= project.status %></td>
          <td class="px-2"><%= project.project_percent %></td>
          <td class="px-2"><.bnw_button_edit phx-value-id={project.id} /></td>
          <td class="px-2"><.bnw_button_delete phx-value-id={project.id} /></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
