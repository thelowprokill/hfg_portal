<div>
  <div class="flex justify-between pb-3">
    <h3 class="text-xl w-2/3"><%= @page_title %></h3>

    <div class="w-1/3">
      <.form :let={f}
        for={%{}}
        as={:timeframe}
        phx-change="timeframe"
        phx-submit="timeframe">
        <div class="flex justify-end">
          <.bnw_input f={f} field={:timeframe} type="select" display_name="Timeframe" list={[[key: "Day", value: "day"], [key: "Week", value: "week"], [key: "Month", value: "month"], [key: "Year", value: "year"]]} value={@timeframe} />
          <.bnw_input f={f} field={:date}      type="date"   display_name="Date" value={@date}/>
        </div>
      </.form>
    </div>
  </div>



  <.form :let={s}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table>
      <:header>
        <th class="p-2">Name</th>
        <th class="p-2"></th>
        <th class="p-2">Hours</th>
      </:header>
      <%= for user <- @users do %>
        <tr>
          <td class="px-2">
            <%= user.last_name %>, 
            <%= user.first_name %> 
            - <%= Enum.reduce(user.capacities, 0, fn capacity, acc -> acc + capacity.capacity end) %>
            hours</td>
          <td class="px-2"></td>
        </tr>
        <%= for timesheet <- user.timesheets do %>
          <%= if timesheet.hours || timesheet.minutes do %>
            <tr>
              <td class="px-2"></td>
              <td class="px-2"><%= timesheet.name %></td>
              <td class="px-2"><%= timesheet.hours %>:<%= String.pad_leading("#{timesheet.minutes}", 2, "0") %></td>
            </tr>
          <% end %>
        <% end %>
        <tr>
          <td class="px-2"></td>
          <td class="px-2">Total</td>
          <td class="px-2">
            <% %{hours: hours, minutes: minutes} = Enum.reduce(user.timesheets, %{hours: 0, minutes: 0}, fn timesheet, acc ->
              cond do
                timesheet.hours && timesheet.minutes ->
                  %{hours: acc.hours + timesheet.hours, minutes: acc.minutes + timesheet.minutes} 
                timesheet.hours ->
                  %{hours: acc.hours + timesheet.hours, minutes: acc.minutes} 
                timesheet.minutes ->
                  %{hours: acc.hours, minutes: acc.minutes + timesheet.minutes} 
                true ->
                  %{hours: acc.hours, minutes: acc.minutes} 
              end
            end) %>
            <%= hours + div(minutes, 60) %>:<%= String.pad_leading("#{rem(minutes, 60)}", 2, "0") %>
          </td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <% modal = stack_tail(@modal_stack) %>
  <%= cond do 
    modal && Map.get(modal, :live, false) -> 
      live_render(
        @socket,
        modal.module, 
        id: "modal_#{modal.modal}_#{modal.id}",
        session: %{"modal" => modal, "parent" => self()}
      )
    modal -> 
      live_component(%{
        module: modal.module, 
        id: "modal_#{modal.modal}_#{modal.id}",
        modal: modal
      })
    true -> nil
  end %>
</div>
