<div>
  <div class="flex justify-between pb-3">
    <div class="w-2/3">
      <h3 class="text-xl"><%= @page_title %></h3>

      <div class="py-3"><.bnw_button_primary phx_click="reset_filters">Reset Filters</.bnw_button_primary></div>
    </div>

    <div class="w-1/3">
      <div class="flex justify-end">
        <.form :let={f}
           for={@cap_prev}
           as={:cap_prev}
           phx-change="cap_prev"
           phx-submit="cap_prev">

           <.bnw_input_hidden f={f} field={:user_id} value={@current_user.id} />
           <.bnw_input_hidden f={f} field={:monday} value={@prev_monday} /> 
           <.bnw_input f={f} field={:capacity} type="number" display_name="Previous Capacity" debounce="blur" />

        </.form>
        <.form :let={f}
           for={@cap_this}
           as={:cap_this}
           phx-change="cap_this"
           phx-submit="cap_this">

           <.bnw_input_hidden f={f} field={:user_id} value={@current_user.id} />
           <.bnw_input_hidden f={f} field={:monday} value={@this_monday} /> 
           <.bnw_input f={f} field={:capacity} type="number" display_name="Current Capacity" debounce="blur" />

        </.form>
        <.form :let={f}
           for={@cap_next}
           as={:cap_next}
           phx-debounce="blur"
           phx-change="cap_next"
           phx-submit="cap_next">

           <.bnw_input_hidden f={f} field={:user_id} value={@current_user.id} />
           <.bnw_input_hidden f={f} field={:monday} value={@next_monday} /> 
           <.bnw_input f={f} field={:capacity} type="number" display_name="Next Capacity" debounce="blur" />

        </.form>
      </div>
    </div>
  </div>

  <.form :let={f}
    for={@search_map}
    as={:search}
    phx-change="search"
    phx-submit="search">
    <.bnw_table height="80vh">
      <:header>
        <th class="p-2"></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:key}>Key</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:name}>Project</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:status}>Status</.bnw_table_header_filter></th>
        <th class="p-2"><.bnw_table_header_filter f={f} search_stack={@search_stack} sort_stack={@sort_stack} field={:project_percent}>Project Percent</.bnw_table_header_filter></th>
        <th class="p-2"></th>
      </:header>
      <%= for project <- @favorite_projects do %>
        <tr phx-click="timesheets" phx-value-id={project.id} class="cursor-pointer">
          <td class="px-2"><.bnw_button_icon bnw_icon="star" fill="yellow" phx_click="remove_favorite" phx-value-id={project.id}/></td>
          <td class="px-2"><%= project.key %></td>
          <td class="px-2"><%= project.name %></td>
          <td class="px-2"><%= project.status %></td>
          <td class="px-2"><%= project.project_percent %></td>
          <td class="px-2"><.bnw_button_primary phx_click="timesheets" phx-value-id={project.id}>Timesheets</.bnw_button_primary></td>
        </tr>
      <% end %>
      <%= for project <- @fixed_projects do %>
        <tr phx-click="fixed_timesheets" phx-value-id={project.id} class="cursor-pointer">
          <td></td>
          <td class="px-2"><%= project.key %></td>
          <td class="px-2"><%= project.name %></td>
          <td class="px-2"><%= project.status %></td>
          <td class="px-2"><%= project.project_percent %></td>
          <td class="px-2"><.bnw_button_primary phx_click="fixed_timesheets" phx-value-id={project.id}>Timesheets</.bnw_button_primary></td>
        </tr>
      <% end %>
      <%= for project <- @projects do %>
        <tr phx-click="timesheets" phx-value-id={project.id} class="cursor-pointer">
          <td class="px-2"><.bnw_button_icon bnw_icon="star" phx_click="add_favorite" phx-value-id={project.id}/></td>
          <td class="px-2"><%= project.key %></td>
          <td class="px-2"><%= project.name %></td>
          <td class="px-2"><%= project.status %></td>
          <td class="px-2"><%= project.project_percent %></td>
          <td class="px-2"><.bnw_button_primary phx_click="timesheets" phx-value-id={project.id}>Timesheets</.bnw_button_primary></td>
        </tr>
      <% end %>
    </.bnw_table>
  </.form>

  <.bnw_modal_render socket={@socket} modal_stack={@modal_stack} />
</div>
