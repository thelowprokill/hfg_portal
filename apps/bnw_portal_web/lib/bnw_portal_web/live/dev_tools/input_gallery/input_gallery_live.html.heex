<%= if @modal do %>
  <.bnw_modal id="modal">
    <.bnw_modal_header>Sample Inputs</.bnw_modal_header>
    <!-- Modal body -->
    <.bnw_modal_body >
      <.form :let={f}
        for={@form}
        as={:form_search}
        phx-submit="search"
        phx-change="search">
  
        <div class="flex">
        <.bnw_input_naked f={f} type="checkbox" field={:checkbox}    display_name="Checkbox" />
        <.bnw_input_naked f={f} type="checkbox" field={:checkbox2}   display_name="Checkbox2" />
        </div>
        <div class="flex">
        <.bnw_input_naked f={f} type="checkbox" field={:checkbox3}    display_name="Checkbox3" />
        <.bnw_input_naked f={f} type="checkbox" field={:checkbox4}    display_name="Checkbox4" />
        </div>
        <.bnw_input f={f} type="color"    field={:color}       display_name="Color" />
        <.bnw_input f={f} type="date"     field={:date}        display_name="Date" />
        <.bnw_input f={f} type="datetime-local" field={:datetime}    display_name="Date Time" />
        <.bnw_input f={f} type="email"    field={:email}       display_name="Email" />
        <.bnw_input f={f} type="file"     field={:file}        display_name="File" />
        <.bnw_input f={f} type="image"    field={:image}       display_name="Image" />
        <.bnw_input f={f} type="month"    field={:month}       display_name="Month" />
        <.bnw_input f={f} type="number"   field={:number}      display_name="Number" />
        <.bnw_input f={f} type="number"   field={:number_l}    display_name="Limited" min={1} max={10} />
        <.bnw_input f={f} type="number"   field={:decimal}     display_name="Decimal" min={1} max={10} step={0.1}/>
        <.bnw_input f={f} type="password" field={:password}    display_name="Password" />
        <div class="flex">
        <.bnw_input_naked f={f} type="radio"    field={:radio}       display_name="Radio" />
        <.bnw_input_naked f={f} type="radio"    field={:radio_2}     display_name="Radio_2" />
        </div>
        <.bnw_input f={f} type="range"    field={:range}       display_name="Range" min={10} max={88} />
        <.bnw_input f={f} type="reset"    field={:reset}       display_name="Reset" />
        <.bnw_input f={f} type="select"   field={:select}      display_name="Select" 
                                                               list={[
                                                                [value: 1, key: "One"],
                                                                [value: 2, key: "Two"],
                                                                [value: 3, key: "Three"],
                                                                [value: 4, key: "Four"],
                                                               ]}
        />
        <.bnw_input f={f} type="text"     field={:text}        display_name="Text" />
        <.bnw_input f={f} type="textarea" field={:text_area}   display_name="Textarea" />
  
      </.form>
    </.bnw_modal_body>

    <!-- Modal footer -->
    <.bnw_modal_footer><.bnw_button_cancel /><.bnw_button_save /></.bnw_modal_footer>
  </.bnw_modal>
<% end %>
